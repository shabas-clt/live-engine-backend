# Server Config
PORT=8001
NODE_ENV=development
ENVIRONMENT=development

# Database (PostgreSQL with TimescaleDB extension)
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_USER=postgres
TIMESCALEDB_PASSWORD=your_password
TIMESCALEDB_DATABASE=live_engine

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# Default Super Admin
DEFAULT_ADMIN_EMAIL=admin@funfin.io
DEFAULT_ADMIN_PASSWORD=changeme123
DEFAULT_ADMIN_NAME=Super Admin

# CORS
ADMIN_PANEL_URL=http://localhost:3002
MAIN_APP_URL=http://localhost:5001

# Initial Tiingo Token (more tokens added via admin panel)
INITIAL_TIINGO_TOKEN=6de31d1c77fb3093cc7e1a0596c96add964a601a

# Finnhub API Keys (for stock data - get free keys at https://finnhub.io)
# Free tier allows 1 WebSocket connection per API key
# Use 3 different keys to support all markets simultaneously
FINNHUB_API_KEY=your_finnhub_api_key_for_us_stocks
FINNHUB_API_KEY_INDIAN=your_finnhub_api_key_for_indian_stocks
FINNHUB_API_KEY_UK=your_finnhub_api_key_for_uk_stocks

# Data Collection Settings
COLLECT_BTC=true
COLLECT_GOLD=true
COLLECT_SILVER=true
COLLECT_INDIAN_STOCKS=false

# Storage Settings
STORE_RAW_TICKS=true
CANDLE_INTERVALS=1m,5m,15m,1h,1d
